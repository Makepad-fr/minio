# Production MinIO settings
MAKEPAD_MINIO_BIND_ADDRESS=0.0.0.0
MAKEPAD_MINIO_PORT=9000
MAKEPAD_MINIO_CONSOLE_PORT=9001
MAKEPAD_MINIO_DATA_PATH=/var/lib/makepad/minio
MAKEPAD_MINIO_BACKUP_PATH=/var/backups/makepad/minio
MAKEPAD_MINIO_RETENTION_DAILY=30
MAKEPAD_MINIO_RETENTION_MONTHLY=12
MAKEPAD_MINIO_RESTIC_REPOSITORY=sftp:makepad-storagebox:catwlk/minio
MAKEPAD_BETACREW_PRODUCTION_BUCKET=betacrew-production
MAKEPAD_BETACREW_PRODUCTION_USER=betacrew-production-app
