[Unit]
Description=Back up Makepad MinIO to restic
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/makepad/minio
Environment=HOME=/root
Environment=XDG_CACHE_HOME=/root/.cache
ExecStart=/srv/makepad/minio/scripts/backup-minio.sh
