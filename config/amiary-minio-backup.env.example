# Install as /etc/makepad/amiary-minio-backup.env with mode 0600.
# This file contains paths and confirmations only; credentials stay in their
# separate two-line files and must never be copied into this file.

# Operator-side backup traffic uses the existing MinIO management network. This
# is not an Amiary application endpoint. The app stays disconnected until a
# private certificate-verified TLS endpoint and CA are provisioned.
AMIARY_MINIO_NETWORK=replace-with-existing-minio-management-network
AMIARY_MINIO_HOST=http://makepad-minio:9000
AMIARY_MINIO_BUCKET=amiary-photos
AMIARY_MINIO_BACKUP_CREDENTIALS_FILE=/etc/makepad/secrets/minio/backup/amiary.credentials

AMIARY_STORAGEBOX_MOUNT=/mnt/makepad-storagebox
AMIARY_BACKUP_ROOT=/mnt/makepad-storagebox/amiary-minio
AMIARY_BACKUP_REQUIRE_MOUNTPOINT=true
AMIARY_STORAGEBOX_TRANSPORT_ENCRYPTION_CONFIRMED=
AMIARY_STORAGEBOX_AT_REST_ENCRYPTION_CONFIRMED=
AMIARY_BACKUP_RETENTION_DAYS=35

# Used only by an operator-triggered restore, never by the timer.
AMIARY_MINIO_RESTORE_CREDENTIALS_FILE=/run/makepad/amiary-minio-restore.credentials
AMIARY_RESTORE_WORK_DIR=/var/lib/makepad/amiary-minio-restore
